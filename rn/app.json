{
  "expo": {
    "name": "RexiPay",
    "slug": "rexipay-rn",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/new.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rexipay.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow RexiPay to use Face ID to securely unlock your app.",
        "ITSAppUsesNonExemptEncryption": true
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/new.png"
      },
      "package": "com.rexipay.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/images/new.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-camera",
      "expo-web-browser",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow RexiPay to use your location to help protect your account and verify secure transactions."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow RexiPay to use Face ID to securely unlock your app."
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/new.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/images/new.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200
        }
      ]
    ],
    "owner": "michaelusd",
    "runtimeVersion": "exposdk:57.0.0",
    "updates": {
      "url": "https://u.expo.dev/72e19737-bfa1-4cea-a4fe-21a8eac19a8c"
    },
    "extra": {
      "eas": {
        "projectId": "72e19737-bfa1-4cea-a4fe-21a8eac19a8c"
      }
    }
  }
}
